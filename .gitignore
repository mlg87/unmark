# Generated from project.yml by `make project`.
*.xcodeproj
App/Info.plist
DerivedData/
build/
# SwiftPM build output from `make test`.
.build/
.swiftpm/
Brewfile.lock.json
node_modules/
# Renderer bundle output, rebuilt by `pnpm --dir renderer build` (#14).
App/Resources/Renderer/
# Site build output, rebuilt by `pnpm --dir site build` (#182).
site/dist/
site/dist-server/
# Responsive images, rebuilt by site/scripts/optimize-images.mjs before dev, build, and test (#183).
site/src/assets/generated/
# Social card and favicons, rebuilt by site/scripts/brand-images.mjs before dev and build (#192).
site/public/og.png
site/public/favicon-32.png
site/public/favicon-192.png
site/public/apple-touch-icon.png
# bd appends to this audit log on every bead change, always in the main checkout,
# which left main permanently dirty. The Dolt DB (synced via `bd dolt push`)
# already holds the same history. Kept here, not in .beads/.gitignore, because
# bd regenerates that file.
.beads/interactions.jsonl
# Finder metadata, written into any directory it opens (#175).
.DS_Store
